.DS_Store
node_modules/
.claude/worktrees/

# dong-vat: git chỉ giữ ghi chú, kịch bản, plan và script. Ảnh, video và log chép riêng.
dong-vat/**
!dong-vat/**/
!dong-vat/**/*.md
!dong-vat/**/*.json
!dong-vat/**/*.mjs
!dong-vat/**/*.sh
!dong-vat/**/*.txt

# mon-an: cùng quy tắc với dong-vat. Riêng ảnh bìa kênh trong mon-an/kenh/ giữ trong git.
mon-an/**
!mon-an/**/
!mon-an/**/*.md
!mon-an/**/*.json
!mon-an/**/*.mjs
!mon-an/**/*.sh
!mon-an/**/*.txt
!mon-an/kenh/*.jpg

# Đặt sau khối dong-vat: dòng !*.json ở trên không được đưa file này vào git.
**/.claude/settings.local.json

# Video thành phẩm: không commit.
videos/

# toc-dep, san-pham, anh-diem-my: cùng quy tắc với dong-vat. Riêng ảnh gốc sản phẩm (goc.*) giữ trong git.
toc-dep/**
!toc-dep/**/
!toc-dep/**/*.md
!toc-dep/**/*.json
anh-diem-my/**
!anh-diem-my/**/
!anh-diem-my/**/*.md
san-pham/**
!san-pham/**/
!san-pham/**/*.md
!san-pham/**/*.json
!san-pham/**/goc.*
