  "nodes": [
    {
      "id": "d68c1f8f-ea0c-45a8-b0b7-b1523dab8d99",
      "type": "text",
      "position": {
        "x": 560,
        "y": 1999
      },
      "config": {
        "content": "Giữ nguyên hoàn toàn ảnh gốc: trang phục, kiểu tóc, màu tóc, nền, ánh sáng, tư thế, bố cục, màu sắc, kết cấu da toàn thân. Chỉ thay thế duy nhất gương mặt (từ trán đến cằm, bao gồm mắt, mũi, miệng) bằng gương mặt trong ảnh tham chiếu thứ hai. Ánh sáng và tông da trên mặt phải hoà hợp tự nhiên với cổ và thân người trong ảnh gốc. Không thay đổi bất cứ thứ gì khác ngoài gương mặt."
      },
      "width": 292,
      "height": 182
    },
